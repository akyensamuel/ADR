# ============================================================
# Environment variable template — safe to commit.
# Copy this file to .env and fill in the real values.
# ============================================================

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=False
# Comma-separated list of allowed hostnames, e.g.:
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=

# Database
# Leave blank to use local SQLite (development only).
# Set to a full PostgreSQL URL for staging/production, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
